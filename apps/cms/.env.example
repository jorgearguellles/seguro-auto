# Strapi 5 — replace with real values in .env (never commit .env)
HOST=0.0.0.0
PORT=1337

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64').substring(0,32)+',')"
APP_KEYS=CHANGE_ME_KEY1,CHANGE_ME_KEY2

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN_SALT=CHANGE_ME_API_TOKEN_SALT
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT_SECRET
TRANSFER_TOKEN_SALT=CHANGE_ME_TRANSFER_TOKEN_SALT
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Database (SQLite for dev — override in production)
DATABASE_CLIENT=better-sqlite3
DATABASE_FILENAME=./.tmp/data.db
