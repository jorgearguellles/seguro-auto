{
  "kind": "collectionType",
  "collectionName": "plans",
  "info": {
    "singularName": "plan",
    "pluralName": "plans",
    "displayName": "Plan",
    "description": "Insurance plan per country with coverages, benefits, pricing and ordering (ADR-007, AC-02.1, AC-02.2, AC-02.4, AC-02.7, AC-02.12, AC-02.13, AC-02.16)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "shortDescription": {
      "type": "text"
    },
    "basePrice": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "currency": {
      "type": "enumeration",
      "enum": ["COP", "CLP"],
      "required": true
    },
    "coverages": {
      "type": "component",
      "repeatable": true,
      "component": "plan.coverage"
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "plan.benefit"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "recommended": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country"
    }
  }
}
