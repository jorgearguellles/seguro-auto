{
  "kind": "collectionType",
  "collectionName": "form_fields",
  "info": {
    "singularName": "form-field",
    "pluralName": "form-fields",
    "displayName": "Form Field",
    "description": "Configurable form field for the insurance wizard step 1 (AC-01.1, AC-01.4, AC-01.8, AC-01.15)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "string",
      "required": true
    },
    "label": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": ["text", "number", "select", "date", "checkbox"],
      "required": true
    },
    "section": {
      "type": "enumeration",
      "enum": ["applicant", "vehicle"],
      "required": true
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "helpText": {
      "type": "text"
    },
    "errorMessage": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "required": true
    },
    "defaultValue": {
      "type": "string"
    },
    "autocomplete": {
      "type": "string"
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country",
      "required": true
    },
    "options": {
      "type": "component",
      "repeatable": true,
      "component": "field.option"
    },
    "validations": {
      "type": "component",
      "repeatable": true,
      "component": "field.validation"
    }
  }
}
